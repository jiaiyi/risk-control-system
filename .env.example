# ==================== 应用 ====================
APP_NAME=电商风控系统
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ==================== MySQL ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ecs
TEST_DB_NAME=ecs_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== Redis 缓存 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
# 设为 false 时全部走直查数据库（用于验证缓存降级，NFR-14）
REDIS_ENABLED=true
# 特征缓存 TTL（秒）—— 订单/商品维度特征不缓存，此项仅作用于用户/地址/登录/领券/设备/IP
CACHE_TTL_FEATURE=60
CACHE_TTL_PROFILE=300
CACHE_TTL_GRAPH=300
CACHE_TTL_RULE=60

# ==================== LLM（阿里云百炼 · OpenAI 兼容模式）====================
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
LLM_TIMEOUT=60
# AI 助手会话持久化 TTL（秒）
AGENT_SESSION_TTL=86400

# ==================== 风控决策阈值 ====================
# 评分 < PASS → 通过；< MARK → 标记；< REVIEW → 人工审核；>= REVIEW → 拒绝
RISK_PASS_THRESHOLD=30
RISK_MARK_THRESHOLD=60
RISK_REVIEW_THRESHOLD=80
# 多命中一条规则的加分
RISK_MULTI_RULE_BONUS=3
# 一票否决（命中「极高」规则）时的最低分
RISK_VETO_MIN_SCORE=90
# 灰名单加严系数（命中灰名单时对评分加成）
RISK_GRAYLIST_BONUS=15

# ==================== 用户画像动态衰减系数 ====================
# new = α × 本次评分 + (1-α) × 历史评分
# 高活跃：近 30 天订单 ≥ PROFILE_ACTIVE_THRESHOLD
PROFILE_ALPHA_HIGH=0.7
# 中活跃：1 ≤ 近 30 天订单 < PROFILE_ACTIVE_THRESHOLD
PROFILE_ALPHA_MID=0.6
# 低活跃 / 新用户：近 30 天订单 = 0
PROFILE_ALPHA_LOW=0.4
PROFILE_ACTIVE_THRESHOLD=5

# ==================== 关联图谱 ====================
GRAPH_MAX_HOPS=3
GRAPH_MAX_NODES=200
GRAPH_DEFAULT_HOPS=2

# ==================== 名单 ====================
# 白名单有效期上限（天）
WHITELIST_MAX_DAYS=90
# 灰名单默认观察期（天）
GRAYLIST_DEFAULT_DAYS=30
# 单次批量导入行数上限（超出拒绝整批）
LIST_IMPORT_MAX_ROWS=5000

# ==================== 二次验证（Challenge）====================
CHALLENGE_TIMEOUT_MINUTES=5
